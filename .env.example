# Required for manager-only API operations. Use a long, unique password.
MANAGER_PASSWORD="REPLACE_WITH_A_LONG_RANDOM_PASSWORD"

# Pooled Neon connection for application traffic.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/DATABASE?sslmode=verify-full"

# Direct Neon connection used only by Drizzle migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.neon.tech/DATABASE?sslmode=verify-full"
