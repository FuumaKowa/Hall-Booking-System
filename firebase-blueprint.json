{
  "entities": {
    "bookings": {
      "title": "Booking",
      "description": "Hall venue reservation records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "hallId": { "type": "string" },
        "hallName": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "eventType": { "type": "string" },
        "eventDate": { "type": "string" },
        "timeSlot": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "durationHours": { "type": "number" },
        "guestCount": { "type": "number" },
        "selectedAddons": { "type": "array", "items": { "type": "string" } },
        "specialRequests": { "type": "string" },
        "estimatedTotal": { "type": "number" },
        "depositAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "notificationRead": { "type": "boolean" }
      },
      "required": ["referenceNumber", "hallId", "customerName", "eventDate", "timeSlot", "status"]
    },
    "notifications": {
      "title": "Notification",
      "description": "Manager alert and notification logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookingId": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "customerName": { "type": "string" },
        "hallName": { "type": "string" },
        "eventDate": { "type": "string" },
        "estimatedTotal": { "type": "number" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "emailSentTo": { "type": "string" }
      },
      "required": ["type", "title", "timestamp"]
    }
  }
}
