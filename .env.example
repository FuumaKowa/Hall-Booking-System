# APP_URL: The URL where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Required for manager-only API operations. Use a long, unique password.
MANAGER_PASSWORD="REPLACE_WITH_A_LONG_RANDOM_PASSWORD"

# Set true for local JSON-only development when Google application credentials
# are unavailable. Keep false/omitted in a configured cloud deployment.
DISABLE_FIRESTORE="true"

# Required on Vercel when Firestore is enabled. Store the complete Firebase
# service-account JSON as one environment-variable value. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON='{"project_id":"...","client_email":"...","private_key":"..."}'
